{
  "name": "code-agents-webcli",
  "version": "6.1.2",
  "description": "Multiuser web CLI for Claude Code, Codex, and terminal sessions",
  "desktopName": "io.github.dnviti.code-agents-webcli.desktop",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "exports": {
    ".": "./dist/server/index.js",
    "./sdk/contracts": "./dist/sdk/contracts/index.js",
    "./sdk/contracts/controller": "./dist/sdk/contracts/controller.js",
    "./sdk/browser": "./dist/sdk/browser/index.js",
    "./sdk/node": "./dist/sdk/node/index.js",
    "./dist/server": "./dist/server/index.js",
    "./dist/server/routes": "./dist/server/routes/index.js",
    "./dist/server/services/environments": "./dist/server/services/environments/index.js",
    "./dist/server/*.js": "./dist/server/*.js",
    "./dist/server/*": "./dist/server/*.js",
    "./dist/shared/*.js": "./dist/shared/*.js",
    "./dist/shared/*": "./dist/shared/*.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "code-agents-webcli": "bin/cc-web.js",
    "cc-web": "bin/cc-web.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "desktop": "npm run build && electron desktop/main.js",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win:unsigned": "npm run build && electron-builder --win nsis --x64 --publish never --config.forceCodeSigning=false --config.win.signExecutable=false",
    "desktop:dist:mac:x64:unsigned": "npm run build && CODE_AGENTS_WEBCLI_SKIP_NOTARIZATION=1 electron-builder --mac dmg zip --x64 --publish never --config.forceCodeSigning=false --config.mac.identity=null --config.mac.hardenedRuntime=false",
    "desktop:dist:mac:arm64:unsigned": "npm run build && CODE_AGENTS_WEBCLI_SKIP_NOTARIZATION=1 electron-builder --mac dmg zip --arm64 --publish never --config.forceCodeSigning=false --config.mac.identity=null --config.mac.hardenedRuntime=false",
    "desktop:dist:linux:deb": "npm run build && electron-builder --linux deb --publish never",
    "desktop:dist:linux:rpm": "npm run build && electron-builder --linux rpm --publish never",
    "desktop:dist:linux:deb-rpm": "npm run build && electron-builder --linux deb rpm --publish never",
    "start": "npm run build && node bin/cc-web.js",
    "dev": "npm run build && node bin/cc-web.js --dev",
    "test": "npm run build && node scripts/run-tests.js",
    "test:strict": "npm run test -- --strict",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "prepack": "npm run build",
    "release:pr": "bash scripts/release/release-pr.sh",
    "test:browser": "npm run build && node test/browser/run.js",
    "test:browser:strict": "npm run build && node test/browser/run.js --strict",
    "test:desktop-attachments": "node test/electron-attachment/run.js",
    "verify:install": "bash scripts/release/verify-install.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "web",
    "terminal",
    "browser",
    "remote",
    "ai",
    "github-oauth",
    "sqlite",
    "multiuser"
  ],
  "author": "Daniele Viti",
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@ngrok/ngrok": "^1.7.0",
    "@particle/dbus-next": "0.11.4",
    "@peculiar/x509": "^2.0.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "openpgp": "6.3.1",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnviti/code-agents-webcli.git"
  },
  "homepage": "https://github.com/dnviti/code-agents-webcli#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.1",
    "mocha": "^11.7.5",
    "monaco-editor": "^0.56.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
