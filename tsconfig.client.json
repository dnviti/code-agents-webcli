{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist/client",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "declaration": false,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/client/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/sdk/browser/**/*.ts",
    "src/sdk/contracts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/sdk/node"]
}
